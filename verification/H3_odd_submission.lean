private lemma fast_small_odd_certificates : ∀ band ∈ smallOddBands,
    let f := band.lower - ∑ p ∈ fastHigh band.upper band.cutoff, (band.upper+p-1)/p
    let m := (fastLow band.upper band.cutoff).card
